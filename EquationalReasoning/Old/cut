-- We can count the number of elements in a list using the function length.

length :: [a] -> Int
length xs = fold inc 0 xs
  where 
    inc :: a -> Int -> Int 
    inc a n = n + 1    

-- The length function works because the anonymous function adds 1
-- for as many instances of (:) there are in the list.
