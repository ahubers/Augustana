   "source": [
    "def map(f , xs):\n",
    "    return [f(x) for x in xs]\n",
    "\n",
    "i = 0 \n",
    "def count(x):\n",
    "    global i\n",
    "    i += 1\n",
    "    return x + i\n",
    "\n",
    "print(map(count, map(count, [1, 2, 3])))\n",
    "print(map(lambda x: count(count(x)), [1, 2, 3]))"
   ]
  },
